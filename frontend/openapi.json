{
  "components": {
    "schemas": {
      "FieldError": {
        "properties": {
          "loc": {
            "description": "Path to the offending field",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "IdentityOut": {
        "additionalProperties": false,
        "properties": {
          "last_login_at": {
            "format": "date-time",
            "title": "Last Login At",
            "type": "string"
          },
          "linked_at": {
            "format": "date-time",
            "title": "Linked At",
            "type": "string"
          },
          "provider": {
            "enum": [
              "github",
              "google"
            ],
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "linked_at",
          "last_login_at"
        ],
        "title": "IdentityOut",
        "type": "object"
      },
      "Problem": {
        "description": "Problem details object (RFC 9457) with a request_id extension member.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Provider": {
        "enum": [
          "github",
          "google"
        ],
        "title": "Provider",
        "type": "string"
      },
      "ProvidersOut": {
        "additionalProperties": false,
        "properties": {
          "providers": {
            "items": {
              "enum": [
                "github",
                "google"
              ],
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers"
        ],
        "title": "ProvidersOut",
        "type": "object"
      },
      "SignedOutEverywhere": {
        "additionalProperties": false,
        "properties": {
          "sessions_revoked": {
            "title": "Sessions Revoked",
            "type": "integer"
          }
        },
        "required": [
          "sessions_revoked"
        ],
        "title": "SignedOutEverywhere",
        "type": "object"
      },
      "UserOut": {
        "additionalProperties": false,
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "identities": {
            "items": {
              "$ref": "#/components/schemas/IdentityOut"
            },
            "title": "Identities",
            "type": "array"
          },
          "unit_pref": {
            "enum": [
              "metric",
              "imperial"
            ],
            "title": "Unit Pref",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "avatar_url",
          "unit_pref",
          "created_at",
          "identities"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserUpdate": {
        "additionalProperties": false,
        "description": "Partial update: omit a field to leave it alone. Fields cannot be set to null.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "unit_pref": {
            "anyOf": [
              {
                "enum": [
                  "metric",
                  "imperial"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Pref"
          }
        },
        "title": "UserUpdate",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Recipe design, brewing log, tasting notes and beer discovery.",
    "title": "BrewNotes API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/callback/{provider}": {
      "get": {
        "operationId": "callback_api_v1_auth_callback__provider__get",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app; on failure to the sign-in page"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error (problem details)"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error (problem details)"
          }
        },
        "summary": "OAuth callback",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/link/{provider}": {
      "get": {
        "operationId": "link_api_v1_auth_link__provider__get",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the provider's authorization page"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error (problem details)"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error (problem details)"
          }
        },
        "summary": "Link another provider to the signed-in account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login/{provider}": {
      "get": {
        "operationId": "login_api_v1_auth_login__provider__get",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "next",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Next"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the provider's authorization page"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error (problem details)"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error (problem details)"
          }
        },
        "summary": "Start sign-in with GitHub or Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",

# Copy to .env for local development. Never commit .env.
# APP_ENV defaults to production; set development explicitly for http://localhost.
APP_ENV=development

# Database. Development and test databases are both created by docker-compose.
DATABASE_URL=postgresql+psycopg://brewnotes:brewnotes@localhost:5432/brewnotes
TEST_DATABASE_URL=postgresql+psycopg://brewnotes:brewnotes@localhost:5432/brewnotes_test

# At least 32 random bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-at-least-32-random-bytes-before-running-in-production

# Origin the browser sees. Used for OAuth redirect URIs and the CSRF origin check.
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated hostnames accepted by the trusted-host check.
ALLOWED_HOSTS=localhost,127.0.0.1

# OAuth apps (Phase 1). Register separate apps for development and production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reverse-proxy addresses allowed to set X-Forwarded-* headers (production).
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional error reporting.
SENTRY_DSN=

# Phase 3: map tiles. Public by nature; restrict the key to the app's domain at the provider.
VITE_MAP_TILE_KEY=
